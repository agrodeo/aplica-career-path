# App / server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shared secret used by the app backend to authenticate the external worker.
# Use the same value as worker/AUTO_APPLY_WORKER_TOKEN.
