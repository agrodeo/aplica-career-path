# Structured CV extraction on the app server.
OPENAI_API_KEY=
CV_EXTRACTION_MODEL=

# Optional compatibility fallbacks used by server-side extraction if desired.
APPLICATION_LLM_MODEL=
RESUME_LLM_MODEL=


# Protects scheduled inventory refresh endpoint:
# GET/POST /api/cron/sync-jobs
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
